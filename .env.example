# ───────────────────────────────────────────────────────────────────────────
# OurMoment — environment configuration
#
# 1. Copy this file to `.env`            ->  cp .env.example .env
# 2. Paste the values from OurMoment's own Firebase project (ourmoment-prod).
#    Find them in: Firebase Console → Project settings → Your apps → SDK setup.
# 3. Restart the dev server.
#
# Anything prefixed with EXPO_PUBLIC_ is inlined into the client bundle by Expo.
# These Firebase web keys are SAFE to ship in a client — your data is protected
# by Firestore/Storage security rules, NOT by hiding the API key.
#
# If you leave these blank, the app boots into DEMO MODE with rich seed data so
# you can explore every screen without a backend.
# ───────────────────────────────────────────────────────────────────────────

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: point the app at the local Firebase Emulator Suite during dev.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false

# ── Server-side only (DO NOT prefix with EXPO_PUBLIC_, never ships to client) ──
# Set these in functions/.env or via `firebase functions:secrets:set`.
# ANTHROPIC_API_KEY=sk-ant-...
