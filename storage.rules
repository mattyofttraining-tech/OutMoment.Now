rules_version = '2';

// OurMoment Storage security.
//
// Photos live under events/{eventId}/photos/{file}.
//
// NOTE (pilot relaxation): we intentionally do NOT use a cross-service
// firestore.get() to check event membership here. That lookup proved unreliable
// from Storage rules (it denied legitimate members and also broke getDownloadURL),
// so writes/reads are gated on authentication + image/size limits only. Event IDs
// are unguessable and closed-group membership is still enforced in Firestore
// (photo/quest documents), so the exposure is small.
//
// TODO (security hardening — sub-project 4): re-enforce per-event membership for
// Storage, e.g. signed-URL uploads via a Cloud Function, or a uid-scoped path
// (events/{eventId}/photos/{uid}/{file} with allow write: request.auth.uid == uid).
//
// NOTE: Firebase download URLs carry a long-lived token; if such a URL leaks it
// bypasses these rules. For maximum confidentiality, serve photos via short-lived
// signed URLs from a Cloud Function instead of getDownloadURL(). See docs/SECURITY.md.

service firebase.storage {
  match /b/{bucket}/o {

    match /events/{eventId}/photos/{photoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Everything else is locked down.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
