rules_version = '2';

// OurMoment Storage security.
//
// Photos live under events/{eventId}/photos/{uid}/{file} — the path is scoped
// to the uploader's uid so writes can be verified without a cross-service
// firestore.get() (which proved unreliable from Storage rules and broke
// getDownloadURL for legitimate members).
//
// - write: only to your own uid segment, images only, < 15 MB, no overwrites
//   of someone else's object.
// - read: any authenticated user. Event IDs are unguessable and closed-group
//   membership is enforced in Firestore (photo/quest documents), so exposure
//   is limited to users who already hold a valid event id.
//
// NOTE: Firebase download URLs carry a long-lived token; if such a URL leaks it
// bypasses these rules. For maximum confidentiality, serve photos via short-lived
// signed URLs from a Cloud Function instead of getDownloadURL(). See docs/SECURITY.md.

service firebase.storage {
  match /b/{bucket}/o {

    match /events/{eventId}/photos/{uid}/{photoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Everything else is locked down.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
