{
  "expo": {
    "name": "OurMoment",
    "slug": "ourmoment",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ourmoment",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fitness.fitsync.ourmoment",
      "infoPlist": {
        "NSCameraUsageDescription": "OurMoment uses your camera so you can capture photos for your event's quests.",
        "NSPhotoLibraryUsageDescription": "OurMoment needs access to save the moments you choose to keep before they expire.",
        "NSPhotoLibraryAddUsageDescription": "OurMoment saves the moments you keep to your photo library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#A3564A"
      },
      "package": "fitness.fitsync.ourmoment",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "OurMoment uses your camera so you can capture photos for your event's quests."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "OurMoment saves the moments you keep to your photo library.",
          "savePhotosPermission": "OurMoment saves the moments you keep to your photo library.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0F"
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
